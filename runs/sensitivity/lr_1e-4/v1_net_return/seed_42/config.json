{
  "agent": {
    "algorithm": "DQN",
    "policy": "MlpPolicy",
    "net_arch": [
      64,
      64
    ],
    "activation": "relu",
    "learning_rate": 0.0001,
    "batch_size": 64,
    "gamma": 0.99,
    "buffer_size": 100000,
    "learning_starts": 5000,
    "train_freq": 4,
    "gradient_steps": 1,
    "target_update_interval": 2000,
    "max_grad_norm": 10.0
  },
  "exploration": {
    "strategy": "epsilon-greedy lineal",
    "exploration_initial_eps": 1.0,
    "exploration_final_eps": 0.05,
    "exploration_fraction": 0.3
  },
  "env": {
    "initial_capital": 100000.0,
    "transaction_cost_bps": 10.0,
    "train_episode_length": 1024,
    "train_random_start": true
  },
  "training": {
    "reward": "v1_net_return",
    "total_timesteps": 300000,
    "seeds": [
      42,
      43,
      44
    ],
    "output_dir": "runs"
  },
  "selection": {
    "eval_freq": 20000,
    "metric": "total_return",
    "patience": 6
  }
}